# LLM provider: mock | ollama | openai
LLM_PROVIDER=ollama

# Ollama local LLM settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenAI Responses API settings (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# WorldLand / EVM certificate registry settings (optional; mock chain is default demo mode)
# Fill these only in your local .env after creating a funded test wallet through MetaMask/faucet.
# Never paste WALLET_PRIVATE_KEY into chat, Notion, Git, screenshots, or presentation files.
WORLDLAND_NETWORK_NAME=WorldLand Test Network
WORLDLAND_RPC_URL=
WORLDLAND_CHAIN_ID=
WORLDLAND_CURRENCY_SYMBOL=WLC
WORLDLAND_BLOCK_EXPLORER_URL=
WORLDLAND_CONTRACT_ADDRESS=
WALLET_PRIVATE_KEY=
EVAL_AGENT_ADDRESS=0x0000000000000000000000000000000000000001
