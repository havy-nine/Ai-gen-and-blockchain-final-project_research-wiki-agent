{
  "collapse-filter": false,
  "search": "-path:\"Daily Logs\" -path:\"Evidence\" -path:\"Evaluation\" -path:\"_hidden\" -Hallucinated -FAIL_LOCAL_ONLY",
  "showTags": true,
  "showAttachments": false,
  "hideUnresolved": true,
  "showOrphans": false,
  "collapse-color-groups": true,
  "colorGroups": [
    {
      "query": "path:Pages",
      "color": {
        "a": 1,
        "rgb": 5395026
      }
    },
    {
      "query": "path:Methods OR path:Tasks OR path:Datasets",
      "color": {
        "a": 1,
        "rgb": 11657298
      }
    },
    {
      "query": "path:Research Notes",
      "color": {
        "a": 1,
        "rgb": 16755200
      }
    }
  ]
}